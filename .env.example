# BrandBridge — 環境変数（コピー用）

# --- 必須 ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- 本番・ベータで推奨（OG / sitemap / canonical）---
# 末尾スラッシュなし。正式ドメイン（SNS・canonical もこれを使う）
NEXT_PUBLIC_SITE_URL=https://www.brandbridge.jp

# 一時的にエラー詳細（message / stack）を画面表示（本番調査用。調査後は削除推奨）
# NEXT_PUBLIC_SHOW_ERROR_DETAILS=true

# ベータ運用: true のとき新規案件のみ review_status=approved で作成
# 管理者審査を使う場合は false（pending_review で /admin/cases に出る）
BETA_AUTO_APPROVE_CASES=false

# --- サーバー専用（NEXT_PUBLIC にしない）---
# Supabase → Project Settings → API → service_role
# /cases の応募件数集計（RLS を超えた集計読取）と admin:create で使用
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=ChangeMe_StrongPass_8chars
# 実行: npm run admin:create

# お問い合わせ通知・管理画面からの返信（Resend）※必須（サーバー専用）
# .env.local と Vercel Environment Variables（Production / Preview）の両方に設定
RESEND_API_KEY=re_xxxxxxxx
CONTACT_RECEIVE_EMAIL=you@example.com
# 未登録企業向け営業メール（/admin/mail）— From と Reply-To は同一営業アドレス推奨
# 例: BrandBridge <sales@brandbridge.jp> / REPLY_TO_EMAIL=sales@brandbridge.jp
MAIL_FROM_NAME=BrandBridge
MAIL_FROM_ADDRESS=sales@brandbridge.jp
REPLY_TO_EMAIL=sales@brandbridge.jp
# Resend 受信: Dashboard → Webhooks → email.received → /api/resend/inbound
# （受信ドメインを MAIL_FROM_ADDRESS に設定）
# CONTACT 通知の From は当面 onboarding@resend.dev（lib/sendContactEmail.ts）

# --- Marketing Agent（/admin/marketing-agent、サーバー専用）---
# Groq が既定。OpenAI は MARKETING_AI_PROVIDER=openai で切替。
# キー本体をコミットしないこと。未設定でも管理画面は表示される（AI実行時にエラー）
# llama-3.3-70b-versatile は Groq が 2026-08-16 に停止。コード側で openai/gpt-oss-120b に読み替える
MARKETING_AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- PR Video worker（Vercel → Cloud Run。R2 secret と MoneyPrinterTurbo は Cloud Run のみ）---
# PR_VIDEO_WORKER_URL=https://pr-video-worker-645546009546.asia-northeast1.run.app
# PR_VIDEO_WORKER_SECRET=
# 自動生成の Pexels 検索は Vercel 側。キーはソースに書かない。
# PEXELS_API_KEY=

# --- PR Video engine（ローカル。Cloud Run に MoneyPrinterTurbo が無い場合は自動で BrandBridge 側に戻る）---
# PR_VIDEO_ENGINE=moneyprinterturbo
# PR_VIDEO_ENGINE=brandbridge
# MONEYPRINTERTURBO_ROOT=C:\Users\you\Desktop\BrandBridge\vendor\MoneyPrinterTurbo
# Optional stock APIs for 会社PR「自動生成」(Pexels / Pixabay / Coverr). Never commit keys.
# If unset, Mixkit/public catalog then existing Ken Burns is used.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# COVERR_API_KEY=

# Cloud Run のみ（Vercel には置かない）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=brandbridge-pr-videos
# R2_S3_ENDPOINT=
# NEXT_PUBLIC_SUPABASE_URL は画像 SSRF 許可リストにも使う

# Google Search Console（サービスアカウント、読み取り専用）
# Search Console プロパティにサービスアカウントを追加すること
# GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:your-domain.example
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=marketing-agent@your-project.iam.gserviceaccount.com
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# または JSON を1行で:
# GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# --- Marketing Agent research（サーバー専用。Cookieは置かない）---
# 公開Web（Jina Reader）。本番DBに AgentReach / Cookie を保存しない
# AGENT_REACH_DISABLED=true
# ローカルCLI（任意）:
# AGENT_REACH_BIN=C:\Users\you\.agent-reach-venv\Scripts\agent-reach.exe

# --- SNS投稿（サーバー専用。NEXT_PUBLIC にしない。値は空のままコピー）---
# X OAuth 1.0a（管理画面「Xに投稿」。自動投稿しない）
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# LinkedIn 個人プロフィール投稿（w_member_social）。会社ページは作らない
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=

# 注意:
# - service_role はサーバーのみ。ブラウザ / NEXT_PUBLIC_* に入れない
# - .env.local は gitignore 済み。実キーをコミットしないこと
# - 詳細: docs/ENV.md / docs/ADMIN_SETUP.md
