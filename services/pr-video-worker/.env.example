# PR video worker (local or Cloud Run). Never commit real values.
PORT=8080
PR_VIDEO_WORKER_SECRET=

# R2 (private bucket; signed GET only). Not needed for /health or 401 checks.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=brandbridge-pr-videos
R2_S3_ENDPOINT=

# Image SSRF allowlist (same public Supabase host as Vercel)
NEXT_PUBLIC_SUPABASE_URL=
