alter table public.deals
add column if not exists agreed_product_name text,
add column if not exists agreed_wholesale_price numeric(14,2),
add column if not exists agreed_moq integer,
add column if not exists agreed_exclusivity text,
add column if not exists agreed_shipping_terms text,
add column if not exists agreed_payment_terms text,
add column if not exists agreed_contract_period text,
add column if not exists agreed_currency text default 'JPY',
add column if not exists agreed_notes text;